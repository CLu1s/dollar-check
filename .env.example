# Solo para correr fuera de CIAB (bun run dev). En CIAB los 3 primeros viven en
# la app Secrets como DOLLAR_CHECK_TELEGRAM_BOT_TOKEN, DOLLAR_CHECK_TELEGRAM_CHAT_ID
# y DOLLAR_CHECK_OXR_APP_ID; el resto usa su default. Ver DEPLOY.md.

# Telegram Bot Token (get it from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram Chat ID (get it from @userinfobot)
TELEGRAM_CHAT_ID=your_chat_id_here

# Open Exchange Rates App ID (https://openexchangerates.org/signup/free)
OXR_APP_ID=your_app_id_here

# Polling interval in minutes (free plan: minimum 60)
POLL_INTERVAL_MINUTES=60

# Alert threshold: minimum % change from last exchange to trigger alert
ALERT_THRESHOLD_PERCENT=0.15

# Trend alert: consecutive days of decline to trigger "change now" alert
TREND_DECLINE_DAYS=3

# Day of month when salary arrives (0 = last day of month)
SALARY_DAY=0

# Salary in USD (gross, before Deel fee)
DEFAULT_SALARY_USD=6097.24

# Deel exchange platform fees
DEFAULT_SPREAD_PERCENT=0.75
DEFAULT_FEE_USD=106.65

# Timezone
TZ=America/Mexico_City

# SQLite path (en CIAB manda BOTTLE_SQLITE_MAIN)
# DB_PATH=data/dollar-check.db

# Puerto HTTP (dashboard en /, /health, /api/context, /api/dashboard)
# PORT=8080
